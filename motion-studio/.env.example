# Clave de la API de Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo que usa la CLI. Por defecto Claude Opus 5.5.
MOTION_MODEL=claude-opus-5-5

# Nivel de esfuerzo de razonamiento: low | medium | high | xhigh | max
MOTION_EFFORT=high

# Opcional: ruta a un Chrome/Chromium propio para renderizar sin descargar uno.
# REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
